{
  "name": "Security Labs",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "lab-target (keep PRIVATE)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
